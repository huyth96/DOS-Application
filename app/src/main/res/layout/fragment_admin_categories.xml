<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    tools:context=".ui.admin.AdminCategoriesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/categoriesContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAdmin"
            style="@style/Widget.DrinkOrder.Toolbar.Admin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:title="@string/admin_toolbar_categories_title"
            app:subtitle="@string/admin_toolbar_categories_subtitle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryCard"
            style="@style/Widget.DrinkOrder.Card.Summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/toolbarAdmin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_dashboard_metrics_title"
                    android:textColor="@color/brand_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_categories_stat_total_label"
                            android:textColor="@color/brand_muted_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCategoriesTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/brand_on_surface"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="8" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="1dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:dividerColor="@color/brand_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_categories_stat_updated_label"
                            android:textColor="@color/brand_muted_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCategoriesUpdated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/brand_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="12 Nov 09:20" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="1dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:dividerColor="@color/brand_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_categories_metric_hidden_label"
                            android:textColor="@color/brand_muted_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvCategoriesHealth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/brand_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Menu structure ready" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearchCategories"
            style="@style/Widget.DrinkOrder.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/admin_categories_search_hint"
            app:startIconDrawable="@drawable/ic_search"
            app:layout_constraintTop_toBottomOf="@id/summaryCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSearchCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAdminCategories"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="96dp"
            android:paddingTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tilSearchCategories"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_admin_category" />

        <LinearLayout
            android:id="@+id/categoryEmptyState"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/rvAdminCategories"
            app:layout_constraintBottom_toBottomOf="@id/rvAdminCategories"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_app_gradient"
                android:contentDescription="@string/admin_hero_illustration_cd"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_truck_24"
                android:clipToOutline="true" />

            <TextView
                android:id="@+id/tvCategoryEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/admin_categories_empty_title"
                android:textAlignment="center"
                android:textColor="@color/brand_on_surface"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="@string/admin_categories_empty_search_title" />

            <TextView
                android:id="@+id/tvCategoryEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/admin_categories_empty_subtitle"
                android:textAlignment="center"
                android:textColor="@color/brand_muted_text"
                android:textSize="14sp"
                tools:text="@string/admin_categories_empty_search_subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCategoryFromEmpty"
                style="@style/Widget.DrinkOrder.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/action_new_category" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/action_new_category"
        android:textAllCaps="false"
        app:layout_anchor="@id/rvAdminCategories"
        app:layout_anchorGravity="bottom|end"
        app:icon="@drawable/ic_add_24" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
