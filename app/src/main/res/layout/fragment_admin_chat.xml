<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/brand_background">

    <TextView
        android:id="@+id/tvChatConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_warning"
        android:padding="12dp"
        android:text="@string/admin_chat_connection_lost"
        android:textColor="@color/brand_on_primary"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminChatThreads"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <LinearLayout
        android:id="@+id/chatEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvChatEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/admin_chat_empty_title"
            android:textAppearance="@android:style/TextAppearance.Medium"
            android:textColor="@color/brand_on_surface" />

        <TextView
            android:id="@+id/tvChatEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_chat_empty_subtitle"
            android:textColor="@color/brand_on_surface_variant" />
    </LinearLayout>

</LinearLayout>
